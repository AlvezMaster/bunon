# Copy to .env.local and adjust. Every variable is optional for a local demo.

# PostgreSQL connection. When unreachable, Bunon falls back to an in-memory store
# seeded with the same demo data (see /api/health).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bunon_db
# auto | postgres | memory
BUNON_DATA_SOURCE=auto

# Signs session cookies. Required in production (32+ random characters).
BUNON_SESSION_SECRET=change-me-to-a-long-random-string

# Local SLM runtime used to extract certificate fields (falls back to rules when absent).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
